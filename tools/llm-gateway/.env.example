# Copy to tools/llm-gateway/.env (gitignored). Only secrets and the upstream URL go here.

# Real Managed LiteLLM:
MANAGED_LITELLM_URL=https://managed-litellm.example
MANAGED_LITELLM_KEY=sk-issued-by-the-other-team

# Or, for the PoC with the mock (docker compose --profile mock up):
# MANAGED_LITELLM_URL=http://mock-managed:8080
# MANAGED_LITELLM_KEY=sk-mock

# Shared with Callers. Also LiteLLM's admin key.
LITELLM_MASTER_KEY=sk-gateway-change-me
